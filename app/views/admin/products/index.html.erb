<h1>商品管理</h1>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>商品分類コード</th>
      <th>商品名</th>
      <th>数量</th>
      <th>価格</th>
      <th>販売期間</th>
      <th>状態</th>
      <th>操作</th>
    </tr>
  </thead>
  <tbody>
    <% @products.each do |product| %>
      <tr>
        <td><%= product.id %></td>
        <td><%= product.code %></td>
        <td><%= product.name %></td>
        <td><%= product.max_quantity %></td>
        <td><%= product.price %></td>
        <td><%= product.start_date %> ~ <%= product.end_date %></td>
        <td><%= product.active ? '有効' : '無効' %></td>
        <td>
          <%= link_to '編集', edit_admin_product_path(product) %>
          <%= link_to '削除', admin_product_path(product), method: :delete, data: { confirm: '削除してもよろしいですか？' } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to '新規商品作成', new_admin_product_path %>
<%= link_to 'TOP', admin_root_path %>
