<h1>ユーザー管理</h1>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>メールアドレス</th>
      <th>権限</th>
      <th>操作</th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.id %></td>
        <td><%= user.email %></td>
        <td><%= user.role %></td>
        <td>
          <%= link_to '編集', edit_admin_user_path(user) %>
          <%= link_to '削除', admin_user_path(user), method: :delete, data: { confirm: '削除してもよろしいですか？' } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<h2>新規ユーザーの作成</h2>
<%= form_with model: User.new, url: admin_users_path, local: true do |f| %>
  <div>
    <%= f.label :email, 'メールアドレス' %>
    <%= f.text_field :email %>
  </div>
  <div>
    <%= f.label :role, '権限' %>
    <%= f.select :role, User.roles.keys.map { |role| [role.humanize, role] } %>
  </div>
  <%= f.submit '作成' %>
<% end %>
